<%- include('templates/head', { title: title, section: 'admin' }) %>
<style>
    /* Estilos básicos para el panel de administración */
    body { background-color: #222; color: #eee; }
    .admin-container {
        max-width: 1200px;
        margin: 100px auto 50px;
        padding: 30px;
        background: #333;
        border-radius: 8px;
        box-shadow: 0 0 15px rgba(0,0,0,0.5);
    }
    .admin-container h1 { text-align: center; color: var(--primary-color); margin-bottom: 40px; }
    .admin-nav { display: flex; justify-content: center; gap: 20px; margin-bottom: 40px; }
    .admin-nav a {
        background: var(--secondary-color);
        color: var(--light-text);
        padding: 10px 20px;
        border-radius: 5px;
        transition: background 0.3s ease;
    }
    .admin-nav a:hover { background: var(--primary-color); }
    .admin-section { margin-top: 40px; }
    .admin-section h2 { color: var(--accent-color); margin-bottom: 20px; }
    .admin-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    .admin-table th, .admin-table td {
        border: 1px solid #555;
        padding: 10px;
        text-align: left;
    }
    .admin-table th { background-color: #444; color: var(--primary-color); }
    .admin-table tr:nth-child(even) { background-color: #3a3a3a; }
    .admin-table tr:hover { background-color: #4a4a4a; }
    .action-buttons button {
        background: var(--accent-color);
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 4px;
        cursor: pointer;
        margin-right: 5px;
    }
    .action-buttons button.delete { background-color: #e74c3c; }
    .action-buttons button:hover { opacity: 0.8; }

    /* Estilos para formularios de admin */
    .admin-form {
        background: #444;
        padding: 30px;
        border-radius: 8px;
        margin-bottom: 30px;
    }
    .admin-form label { display: block; margin-bottom: 8px; font-weight: bold; }
    .admin-form input[type="text"],
    .admin-form input[type="date"],
    .admin-form textarea {
        width: 100%;
        padding: 10px;
        margin-bottom: 15px;
        border: 1px solid #666;
        border-radius: 4px;
        background-color: #555;
        color: #eee;
        font-size: 1em;
    }
    .admin-form textarea { min-height: 120px; resize: vertical; }
    .admin-form button {
        background: var(--primary-color);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s ease;
    }
    .admin-form button:hover { background: var(--accent-color); }
</style>

<div class="admin-container">
    <h1>Administrar Novedades</h1>

    <nav class="admin-nav">
        <a href="/admin">Panel Principal</a>
        <a href="/admin/novedades" class="active">Administrar Novedades</a>
        <a href="/admin/comentarios">Administrar Testimonios</a>
        <a href="/admin/contactos">Ver Mensajes de Contacto</a>
    </nav>

    <div class="admin-section">
        <h2>Añadir/Editar Novedad</h2>
        <form id="novedadForm" class="admin-form">
            <input type="hidden" id="novedadId">
            <label for="titulo">Título:</label>
            <input type="text" id="titulo" required>
            <label for="fecha">Fecha:</label>
            <input type="date" id="fecha" required>
            <label for="resumen">Resumen:</label>
            <textarea id="resumen" required></textarea>
            <label for="contenido">Contenido:</label>
            <textarea id="contenido" required></textarea>
            <label for="imagen_url">URL de la Imagen:</label>
            <input type="text" id="imagen_url">
            <label for="autor">Autor:</label>
            <input type="text" id="autor" value="Grupo New Name">
            <label for="categoria">Categoría:</label>
            <input type="text" id="categoria">
            <button type="submit">Guardar Novedad</button>
            <button type="button" id="cancelEdit" style="background-color: #555; margin-left: 10px; display: none;">Cancelar Edición</button>
        </form>

        <h2>Lista de Novedades</h2>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Fecha</th>
                    <th>Autor</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="novedadesTableBody">
                <% novedades.forEach(novedad => { %>
                    <tr>
                        <td><%= novedad.id %></td>
                        <td><%= novedad.titulo %></td>
                        <td><%= new Date(novedad.fecha).toLocaleDateString('es-ES') %></td>
                        <td><%= novedad.autor %></td>
                        <td class="action-buttons">
                            <button onclick="editNovedad(<%= JSON.stringify(novedad) %>)">Editar</button>
                            <button class="delete" onclick="deleteNovedad(<%= novedad.id %>)">Eliminar</button>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<script>
    // JavaScript para el CRUD de Novedades
    const novedadForm = document.getElementById('novedadForm');
    const novedadId = document.getElementById('novedadId');
    const tituloInput = document.getElementById('titulo');
    const fechaInput = document.getElementById('fecha');
    const resumenInput = document.getElementById('resumen');
    const contenidoInput = document.getElementById('contenido');
    const imagenUrlInput = document.getElementById('imagen_url');
    const autorInput = document.getElementById('autor');
    const categoriaInput = document.getElementById('categoria');
    const novedadesTableBody = document.getElementById('novedadesTableBody');
    const cancelEditBtn = document.getElementById('cancelEdit');

    // Función para formatear la fecha a YYYY-MM-DD
    function formatDate(dateString) {
        const date = new Date(dateString);
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    novedadForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const data = {
            titulo: tituloInput.value,
            fecha: fechaInput.value,
            resumen: resumenInput.value,
            contenido: contenidoInput.value,
            imagen_url: imagenUrlInput.value,
            autor: autorInput.value,
            categoria: categoriaInput.value
        };

        const id = novedadId.value;
        const method = id ? 'PUT' : 'POST';
        const url = id ? `/api/novedades/${id}` : '/api/novedades';

        try {
            const response = await fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                alert('Novedad guardada con éxito.');
                location.reload(); // Recargar la página para ver los cambios
            } else {
                const error = await response.json();
                alert('Error al guardar novedad: ' + (error.message || 'Error desconocido'));
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error de conexión al guardar novedad.');
        }
    });

    function editNovedad(novedad) {
        novedadId.value = novedad.id;
        tituloInput.value = novedad.titulo;
        fechaInput.value = formatDate(novedad.fecha);
        resumenInput.value = novedad.resumen;
        contenidoInput.value = novedad.contenido;
        imagenUrlInput.value = novedad.imagen_url;
        autorInput.value = novedad.autor;
        categoriaInput.value = novedad.categoria;
        cancelEditBtn.style.display = 'inline-block';
        window.scrollTo({ top: 0, behavior: 'smooth' }); // Scroll al formulario
    }

    cancelEditBtn.addEventListener('click', () => {
        novedadForm.reset();
        novedadId.value = '';
        cancelEditBtn.style.display = 'none';
        autorInput.value = 'Grupo New name'; // Restablecer valor predeterminado
    });


    async function deleteNovedad(id) {
        if (confirm('¿Estás seguro de que quieres eliminar esta novedad?')) {
            try {
                const response = await fetch(`/api/novedades/${id}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    alert('Novedad eliminada con éxito.');
                    location.reload();
                } else {
                    const error = await response.json();
                    alert('Error al eliminar novedad: ' + (error.message || 'Error desconocido'));
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error de conexión al eliminar novedad.');
            }
        }
    }
</script>

<%- include('templates/footer') %>