<%- include('templates/head', { title: title, section: 'admin' }) %>
<style>
    /* Estilos básicos para el panel de administración (puedes unificar los CSS de admin) */
    body { background-color: #222; color: #eee; }
    .admin-container {
        max-width: 1000px;
        margin: 100px auto 50px;
        padding: 30px;
        background: #333;
        border-radius: 8px;
        box-shadow: 0 0 15px rgba(0,0,0,0.5);
    }
    .admin-container h1 { text-align: center; color: var(--primary-color); margin-bottom: 40px; }
    .admin-nav { display: flex; justify-content: center; gap: 20px; margin-bottom: 40px; }
    .admin-nav a {
        background: var(--secondary-color);
        color: var(--light-text);
        padding: 10px 20px;
        border-radius: 5px;
        transition: background 0.3s ease;
    }
    .admin-nav a:hover { background: var(--primary-color); }
    .admin-section { margin-top: 40px; }
    .admin-section h2 { color: var(--accent-color); margin-bottom: 20px; }
    .admin-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    .admin-table th, .admin-table td {
        border: 1px solid #555;
        padding: 10px;
        text-align: left;
    }
    .admin-table th { background-color: #444; color: var(--primary-color); }
    .admin-table tr:nth-child(even) { background-color: #3a3a3a; }
    .admin-table tr:hover { background-color: #4a4a4a; }
    .action-buttons button {
        background: var(--accent-color);
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 4px;
        cursor: pointer;
        margin-right: 5px;
    }
    .action-buttons button.delete { background-color: #e74c3c; }
    .action-buttons button:hover { opacity: 0.8; }

    /* Estilos para formularios de admin */
    .admin-form {
        background: #444;
        padding: 30px;
        border-radius: 8px;
        margin-bottom: 30px;
    }
    .admin-form label { display: block; margin-bottom: 8px; font-weight: bold; }
    .admin-form input[type="text"],
    .admin-form textarea {
        width: 100%;
        padding: 10px;
        margin-bottom: 15px;
        border: 1px solid #666;
        border-radius: 4px;
        background-color: #555;
        color: #eee;
        font-size: 1em;
    }
    .admin-form textarea { min-height: 80px; resize: vertical; }
    .admin-form button {
        background: var(--primary-color);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s ease;
    }
    .admin-form button:hover { background: var(--accent-color); }
</style>

<div class="admin-container">
    <h1>Administrar Testimonios</h1>

    <nav class="admin-nav">
        <a href="/admin">Panel Principal</a>
        <a href="/admin/novedades">Administrar Novedades</a>
        <a href="/admin/comentarios" class="active">Administrar Testimonios</a>
        <a href="/admin/contactos">Ver Mensajes de Contacto</a>
    </nav>

    <div class="admin-section">
        <h2>Añadir/Editar Testimonio</h2>
        <form id="comentarioForm" class="admin-form">
            <input type="hidden" id="comentarioId">
            <label for="nombre">Nombre:</label>
            <input type="text" id="nombre" required>
            <label for="mensaje">Mensaje:</label>
            <textarea id="mensaje" required></textarea>
            <label for="fuente">Fuente (ej. "Bodas.net"):</label>
            <input type="text" id="fuente">
            <button type="submit">Guardar Testimonio</button>
            <button type="button" id="cancelEdit" style="background-color: #555; margin-left: 10px; display: none;">Cancelar Edición</button>
        </form>

        <h2>Lista de Testimonios</h2>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Mensaje</th>
                    <th>Fuente</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="comentariosTableBody">
                <% comentarios.forEach(comentario => { %>
                    <tr>
                        <td><%= comentario.id %></td>
                        <td><%= comentario.nombre %></td>
                        <td><%= comentario.mensaje.substring(0, 70) %>...</td> <!-- Mostrar un resumen -->
                        <td><%= comentario.fuente || 'N/A' %></td>
                        <td><%= new Date(comentario.fecha).toLocaleDateString('es-ES') %></td>
                        <td class="action-buttons">
                            <button onclick="editComentario(<%= JSON.stringify(comentario) %>)">Editar</button>
                            <button class="delete" onclick="deleteComentario(<%= comentario.id %>)">Eliminar</button>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<script>
    const comentarioForm = document.getElementById('comentarioForm');
    const comentarioId = document.getElementById('comentarioId');
    const nombreInput = document.getElementById('nombre');
    const mensajeInput = document.getElementById('mensaje');
    const fuenteInput = document.getElementById('fuente');
    const comentariosTableBody = document.getElementById('comentariosTableBody');
    const cancelEditBtn = document.getElementById('cancelEdit');

    comentarioForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const data = {
            nombre: nombreInput.value,
            mensaje: mensajeInput.value,
            fuente: fuenteInput.value
        };

        const id = comentarioId.value;
        const method = id ? 'PUT' : 'POST';
        const url = id ? `/api/comentarios/${id}` : '/api/comentarios';

        try {
            const response = await fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                alert('Testimonio guardado con éxito.');
                location.reload();
            } else {
                const error = await response.json();
                alert('Error al guardar testimonio: ' + (error.message || 'Error desconocido'));
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error de conexión al guardar testimonio.');
        }
    });

    function editComentario(comentario) {
        comentarioId.value = comentario.id;
        nombreInput.value = comentario.nombre;
        mensajeInput.value = comentario.mensaje;
        fuenteInput.value = comentario.fuente;
        cancelEditBtn.style.display = 'inline-block';
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    cancelEditBtn.addEventListener('click', () => {
        comentarioForm.reset();
        comentarioId.value = '';
        cancelEditBtn.style.display = 'none';
    });

    async function deleteComentario(id) {
        if (confirm('¿Estás seguro de que quieres eliminar este testimonio?')) {
            try {
                const response = await fetch(`/api/comentarios/${id}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    alert('Testimonio eliminado con éxito.');
                    location.reload();
                } else {
                    const error = await response.json();
                    alert('Error al eliminar testimonio: ' + (error.message || 'Error desconocido'));
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error de conexión al eliminar testimonio.');
            }
        }
    }
</script>

<%- include('templates/footer') %>