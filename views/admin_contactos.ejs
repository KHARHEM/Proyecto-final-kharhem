<%- include('templates/head', { title: title, section: 'admin' }) %>
<style>
    /* Estilos básicos para el panel de administración (puedes unificar los CSS de admin) */
    body { background-color: #222; color: #eee; }
    .admin-container {
        max-width: 1000px;
        margin: 100px auto 50px;
        padding: 30px;
        background: #333;
        border-radius: 8px;
        box-shadow: 0 0 15px rgba(0,0,0,0.5);
    }
    .admin-container h1 { text-align: center; color: var(--primary-color); margin-bottom: 40px; }
    .admin-nav { display: flex; justify-content: center; gap: 20px; margin-bottom: 40px; }
    .admin-nav a {
        background: var(--secondary-color);
        color: var(--light-text);
        padding: 10px 20px;
        border-radius: 5px;
        transition: background 0.3s ease;
    }
    .admin-nav a:hover { background: var(--primary-color); }
    .admin-section { margin-top: 40px; }
    .admin-section h2 { color: var(--accent-color); margin-bottom: 20px; }
    .admin-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    .admin-table th, .admin-table td {
        border: 1px solid #555;
        padding: 10px;
        text-align: left;
    }
    .admin-table th { background-color: #444; color: var(--primary-color); }
    .admin-table tr:nth-child(even) { background-color: #3a3a3a; }
    .admin-table tr:hover { background-color: #4a4a4a; }
    .action-buttons button {
        background: var(--accent-color);
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 4px;
        cursor: pointer;
        margin-right: 5px;
    }
    .action-buttons button.delete { background-color: #e74c3c; }
    .action-buttons button:hover { opacity: 0.8; }
</style>

<div class="admin-container">
    <h1>Mensajes de Contacto</h1>

    <nav class="admin-nav">
        <a href="/admin">Panel Principal</a>
        <a href="/admin/novedades">Administrar Novedades</a>
        <a href="/admin/comentarios">Administrar Testimonios</a>
        <a href="/admin/contactos" class="active">Ver Mensajes de Contacto</a>
    </nav>

    <div class="admin-section">
        <h2>Lista de Mensajes</h2>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Asunto</th>
                    <th>Mensaje</th>
                    <th>Fecha Envío</th>
                </tr>
            </thead>
            <tbody id="contactosTableBody">
                <% contactos.forEach(contacto => { %>
                    <tr>
                        <td><%= contacto.id %></td>
                        <td><%= contacto.nombre %></td>
                        <td><%= contacto.email %></td>
                        <td><%= contacto.telefono || 'N/A' %></td>
                        <td><%= contacto.asunto || 'N/A' %></td>
                        <td><%= contacto.mensaje.substring(0, 70) %>...</td>
                        <td><%= new Date(contacto.fecha_envio).toLocaleString('es-ES') %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<%- include('templates/footer') %>